# Copy to .env at the repository root. Existing process environment values win.
# Local mode is the default; do not expose it to the public internet.
APP_MODE=local
HOST=127.0.0.1
PORT=3000
# Relative filesystem paths resolve from the repository root, regardless of cwd.
DATABASE_PATH=data/djdesk.sqlite
AUDIO_UPLOAD_DIR=data/audio
WINDOWS_FLASH_STAGING_DIR=data/windows-flash-import

# Optional integrations; these sibling repositories are not needed for the demo.
# DJ_TOOL_ROOT=../dj
# CHORDAI_KIT_ROOT=../chordai-pipeline-kit
# WINDOWS_FLASH_HOST=windows
# YTDLP_PATH=yt-dlp

# Required in APP_MODE=public; HTTP is accepted only on localhost for development.
# PUBLIC_ORIGIN=https://djdesk.example.com
# PUBLIC_WORKSPACES_PER_DAY=5
# PUBLIC_SETS_PER_WORKSPACE=100
# PUBLIC_TRACKS_PER_SET=300
# PUBLIC_WRITES_PER_MINUTE=120

# Set to true to populate an empty local database with demonstration metadata.
SEED_SAMPLE_DATA=false
# FFPROBE_PATH=/usr/bin/ffprobe
