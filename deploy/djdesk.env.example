APP_MODE=public
PUBLIC_ORIGIN=https://djdesk.example.com
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=/var/lib/djdesk/data/djdesk.sqlite
SEED_SAMPLE_DATA=false
LOG_LEVEL=warn
FFPROBE_PATH=/usr/bin/ffprobe
PUBLIC_WORKSPACES_PER_DAY=5
PUBLIC_SETS_PER_WORKSPACE=100
PUBLIC_TRACKS_PER_SET=300
PUBLIC_WRITES_PER_MINUTE=120
